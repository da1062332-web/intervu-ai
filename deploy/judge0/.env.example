# Copy to .env on the EC2 host and fill in. Never commit .env.

# Public hostname Caddy issues a TLS certificate for. Either your own DNS
# record (judge0.yourdomain.com -> Elastic IP) or <elastic-ip>.sslip.io.
JUDGE0_DOMAIN=judge0.yourdomain.com

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Judge0 rejects requests without a matching X-Auth-Token header.
# Set the same value as JUDGE0_AUTH_TOKEN on the intervu-api Render service.
AUTHN_TOKEN=change-me

# Lets the API delete finished submissions (DELETE /submissions/:token).
# Set the same value as JUDGE0_AUTHZ_TOKEN on the intervu-api Render service.
AUTHZ_TOKEN=change-me
