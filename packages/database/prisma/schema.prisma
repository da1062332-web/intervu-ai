generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  passwordHash       String?
  googleId           String?               @unique
  fullName           String?
  role               UserRole              @default(CANDIDATE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  college            String?
  graduationYear     Int?                  @map("graduation_year")
  phone              String?
  evaluationResults  EvaluationResult[]
  performanceSummary PerformanceSummary?
  refreshTokens      RefreshToken[]
  sessions           Session[]
  templates          Template[]
  tests              Test[]
  testInstances      TestInstance[]
  enrollments        CandidateEnrollment[]
  candidateResults   CandidateResult[]

  @@index([deletedAt])
  @@index([role])
}

model Session {
  id            String         @id @default(cuid())
  userId        String
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  refreshTokens RefreshToken[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model Template {
  id                         String                       @id @default(cuid())
  templateKey                String                       @unique @default(cuid())
  conceptKey                 String                       @default("default_concept")
  difficultyLevel            DifficultyLevel              @default(MEDIUM)
  questionType               String                       @default("multiple_choice")
  structure                  Json                         @default("{}")
  variableSchema             Json                         @default("{}")
  constraints                Json                         @default("{}")
  solutionSchema             Json                         @default("{}")
  version                    Int                          @default(1)
  isActive                   Boolean                      @default(true)
  name                       String                       @default("Legacy Template")
  description                String?
  difficulty                 DifficultyLevel              @default(MEDIUM)
  config                     Json                         @default("{}")
  isSystem                   Boolean                      @default(false)
  creatorId                  String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  deletedAt                  DateTime?
  datasetConfig              Json                         @default("{}")
  generationStrategy         GenerationStrategy           @default(VARIABLE)
  hybridConfig               Json                         @default("{}")
  generatedQuestions         GeneratedQuestion[]
  QuestionGenerationAuditLog QuestionGenerationAuditLog[]
  QuestionGenerationJob      QuestionGenerationJob[]
  creator                    User?                        @relation(fields: [creatorId], references: [id])
  tests                      Test[]
  questions                  Question[]
  solutionTemplate           SolutionTemplate?
  previews                   TemplatePreview[]
  rules                      TemplateRule[]
  variables                  TemplateVariable[]
  datasetConfigRelation      TemplateDatasetConfig?
  promptConfig               TemplatePromptConfig?

  @@index([templateKey])
  @@index([conceptKey])
  @@index([difficultyLevel])
  @@index([creatorId])
  @@index([difficulty])
  @@index([isSystem])
  @@index([deletedAt])
}

model Test {
  id               String            @id @default(cuid())
  templateId       String
  userId           String
  status           TestStatus        @default(DRAFT)
  score            Float?
  feedback         String?
  answers          Json?
  questions        Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  evaluationResult EvaluationResult?
  template         Template          @relation(fields: [templateId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([deletedAt])
}

model SystemConfig {
  id        String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvaluationResult {
  id                 String           @id @default(cuid())
  testId             String?          @unique
  userId             String
  communicationScore Float            @default(0.0)
  technicalScore     Float            @default(0.0)
  confidenceScore    Float
  overallScore       Float
  overallRating      Float            @default(0.0)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  correctAnswers     Int              @default(0)
  evaluatedAt        DateTime         @default(now())
  incorrectAnswers   Int              @default(0)
  testInstanceId     String?          @unique
  totalQuestions     Int              @default(0)
  test               Test?            @relation(fields: [testId], references: [id], onDelete: Cascade)
  testInstance       TestInstance?    @relation(fields: [testInstanceId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations    Recommendation[]
  skillScores        SkillScore[]

  @@index([userId])
  @@index([testId])
  @@index([testInstanceId])
  @@index([overallScore])
  @@index([createdAt])
}

model SkillScore {
  id           String           @id @default(cuid())
  evaluationId String
  skill        String
  score        Float
  feedback     String
  createdAt    DateTime         @default(now())
  evaluation   EvaluationResult @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model TestConfig {
  id                   String                @id @default(cuid())
  configKey            String                @unique
  companyName          String
  displayName          String
  totalDurationSeconds Int
  totalQuestions       Int
  isActive             Boolean               @default(true)
  version              Int                   @default(1)
  createdAt            DateTime              @default(now())
  testInstances        TestInstance[]
  rule                 TestRule?
  sections             TestSection[]
  enrollments          CandidateEnrollment[]

  @@index([configKey])
}

model TestSection {
  id              String     @id @default(cuid())
  testConfigId    String
  sectionKey      String
  displayName     String
  durationSeconds Int
  questionCount   Int
  orderIndex      Int
  testConfig      TestConfig @relation(fields: [testConfigId], references: [id], onDelete: Cascade)

  @@index([testConfigId])
}

model TestRule {
  id               String     @id @default(cuid())
  testConfigId     String     @unique
  negativeMarking  Boolean    @default(false)
  sectionLocking   Boolean    @default(true)
  shuffleQuestions Boolean    @default(false)
  allowNavigation  Boolean    @default(false)
  testConfig       TestConfig @relation(fields: [testConfigId], references: [id], onDelete: Cascade)
}

model GeneratedQuestion {
  id              String          @id @default(cuid())
  templateId      String
  questionHash    String          @unique
  conceptKey      String
  difficultyLevel DifficultyLevel
  questionType    String
  questionText    String
  options         Json
  correctAnswer   Json
  solution        Json
  metadata        Json
  createdAt       DateTime        @default(now())
  template        Template        @relation(fields: [templateId], references: [id])

  @@index([conceptKey])
  @@index([difficultyLevel])
}

model TestInstance {
  id                  String                   @id @default(cuid())
  userId              String
  testConfigId        String?
  status              TestInstanceStatus       @default(CREATED)
  startedAt           DateTime?
  expiresAt           DateTime?
  submittedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  examConfigId        String?
  candidateAnswers    CandidateAnswer[]
  evaluationResult    EvaluationResult?
  executionState      ExecutionState?
  submission          Submission?
  examConfig          ExamConfig?              @relation(fields: [examConfigId], references: [id])
  testConfig          TestConfig?              @relation(fields: [testConfigId], references: [id])
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions           TestInstanceQuestion[]
  sections            TestInstanceSection[]
  assessmentAuditLogs AssessmentAuditLog[]
  candidatePercentile CandidatePercentile?
  candidateRanking    CandidateRanking?
  candidateResult     CandidateResult?
  evaluationAnalytics EvaluationAnalytics?
  evaluationInsight   EvaluationInsight?
  reprocessLogs       EvaluationReprocessLog[]
  evaluationRuns      EvaluationRun[]
  improvementPlan     ImprovementPlan?

  @@index([userId])
  @@index([status])
  @@index([testConfigId])
  @@index([createdAt])
}

model TestInstanceSection {
  id              String                 @id @default(cuid())
  testInstanceId  String
  sectionKey      String
  sectionName     String
  durationSeconds Int
  questionCount   Int
  orderIndex      Int
  status          String                 @default("UPCOMING") @map("status")
  startedAt       DateTime?              @map("started_at")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  questions       TestInstanceQuestion[]
  testInstance    TestInstance           @relation(fields: [testInstanceId], references: [id], onDelete: Cascade)

  @@unique([testInstanceId, orderIndex])
  @@index([testInstanceId])
  @@index([status])
}

model TestInstanceQuestion {
  id               String              @id @default(cuid())
  testInstanceId   String
  sectionId        String
  questionId       String
  questionOrder    Int
  questionSnapshot Json
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  section          TestInstanceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  testInstance     TestInstance        @relation(fields: [testInstanceId], references: [id], onDelete: Cascade)

  @@unique([sectionId, questionOrder])
  @@index([testInstanceId])
  @@index([sectionId])
  @@index([questionId])
}

model CandidateAnswer {
  id                String       @id @default(cuid())
  testInstanceId    String
  questionId        String
  answer            Json
  timeSpentSeconds  Int          @default(0)
  isMarkedForReview Boolean      @default(false)
  savedAt           DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  testInstance      TestInstance @relation(fields: [testInstanceId], references: [id], onDelete: Cascade)

  @@unique([testInstanceId, questionId])
  @@index([testInstanceId])
  @@index([questionId])
}

model ExecutionState {
  id                     String       @id @default(cuid())
  testInstanceId         String       @unique
  currentQuestionIndex   Int          @default(0)
  remainingTimeSeconds   Int
  lastActivityAt         DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  currentQuestionId      String?      @map("current_question_id")
  currentSectionKey      String?      @map("current_section_key")
  currentSectionIndex    Int?         @default(0) @map("current_section_index")
  sectionStartedAt       DateTime?    @map("section_started_at")
  lockedSectionKeys      Json?        @map("locked_section_keys")
  markedQuestions        Json?        @map("marked_questions")
  networkStatusTimestamp DateTime?    @map("network_status_timestamp")
  visitedQuestions       Json?        @map("visited_questions")
  testInstance           TestInstance @relation(fields: [testInstanceId], references: [id], onDelete: Cascade)

  @@index([testInstanceId])
}

model Submission {
  id             String           @id @default(cuid())
  testInstanceId String           @unique
  submittedAt    DateTime?
  submissionHash String?          @unique
  status         SubmissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  errorMessage   String?          @map("error_message")
  retryCount     Int              @default(0) @map("retry_count")
  testInstance   TestInstance     @relation(fields: [testInstanceId], references: [id], onDelete: Cascade)

  @@index([testInstanceId])
  @@index([status])
}

model CandidateResult {
  id                    String       @id @default(cuid())
  candidateId           String       @map("candidate_id")
  attemptId             String       @unique @map("attempt_id")
  score                 Float
  percentage            Float
  evaluationStrategy    String?      @map("evaluation_strategy")
  strategyVersion       Int          @default(1) @map("strategy_version")
  qualification         String?      @map("qualification")
  qualificationReason   String?      @map("qualification_reason")
  foundationScore       Int?         @map("foundation_score")
  advancedScore         Int?         @map("advanced_score")
  codingSolved          Int?         @map("coding_solved")
  qualificationDetails  Json?        @map("qualification_details")
  evaluatedAt           DateTime?    @map("evaluated_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  attempt               TestInstance @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([attemptId])
  @@index([qualification])
  @@index([evaluationStrategy])
  @@map("candidate_results")
}

model EvaluationRun {
  id         String       @id @default(cuid())
  attemptId  String       @map("attempt_id")
  status     String
  error      String?
  durationMs Int          @map("duration_ms")
  createdAt  DateTime     @default(now()) @map("created_at")
  attempt    TestInstance @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("evaluation_runs")
}

model EvaluationAnalytics {
  id                 String       @id @default(cuid())
  attemptId          String       @unique @map("attempt_id")
  topicAccuracy      Json         @map("topic_accuracy")
  difficultyAccuracy Json         @map("difficulty_accuracy")
  completionRate     Float        @map("completion_rate")
  attemptRate        Float        @map("attempt_rate")
  createdAt          DateTime     @default(now()) @map("created_at")
  sectionAccuracy    Json?        @map("section_accuracy")
  attempt            TestInstance @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("evaluation_analytics")
}

model AssessmentAuditLog {
  id           String       @id @default(cuid())
  attemptId    String       @map("attempt_id")
  candidateId  String       @map("candidate_id")
  assessmentId String       @map("assessment_id")
  eventType    String       @map("event_type")
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  testInstance TestInstance @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([candidateId])
  @@index([assessmentId])
  @@map("assessment_audit_logs")
}

model Recommendation {
  id           String                 @id @default(cuid())
  evaluationId String
  skill        String
  priority     RecommendationPriority
  title        String
  description  String
  createdAt    DateTime               @default(now())
  evaluation   EvaluationResult       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([priority])
}

model PerformanceSummary {
  id                 String    @id @default(cuid())
  userId             String    @unique
  testsCompleted     Int       @default(0)
  averageScore       Float     @default(0.0)
  bestScore          Float     @default(0.0)
  lastAssessmentDate DateTime?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExamConfig {
  id                     String                  @id @default(cuid())
  name                   String
  role                   String
  durationMinutes        Int
  totalQuestions         Int
  isActive               Boolean                 @default(true)
  createdBy              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  code                   String                  @unique
  description            String?
  isArchived             Boolean                 @default(false)
  status                 ConfigStatus            @default(DRAFT)
  publishLogs            ConfigPublishLog[]
  difficultyDistribution DifficultyDistribution?
  versions               ExamConfigVersion[]
  sections               ExamSection[]
  ruleFlags              RuleFlags?
  testInstances          TestInstance[]
  assembledTests         AssembledTest[]
  blueprint              Blueprint?
  enrollments            CandidateEnrollment[]
  workflow               ExamWorkflow?
  readinessReports       ReadinessReport[]
  questionUsages         ExamConfigQuestionUsage[]
  hiringEvaluationConfig HiringEvaluationConfig?

  @@index([createdAt])
  @@index([role])
  @@index([status])
}

model ExamSection {
  id                     String                 @id @default(cuid())
  examConfigId           String
  name                   String
  questionCount          Int
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  code                   String
  isRequired             Boolean                @default(true)
  sectionDurationMinutes Int
  sectionOrder           Int
  examConfig             ExamConfig             @relation(fields: [examConfigId], references: [id], onDelete: Cascade)
  sectionTopics          SectionTopic[]
  blueprintTopicConfigs  BlueprintTopicConfig[]
  questions              Question[]

  @@unique([examConfigId, code])
  @@index([examConfigId])
  @@index([sectionOrder])
}

model DifficultyDistribution {
  id               String     @id @default(uuid())
  examConfigId     String     @unique
  easyPercentage   Int
  mediumPercentage Int
  hardPercentage   Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  examConfig       ExamConfig @relation(fields: [examConfigId], references: [id], onDelete: Cascade)

  @@index([examConfigId])
}

model ExamConfigVersion {
  id            String     @id @default(cuid())
  examConfigId  String
  versionNumber Int
  snapshot      Json
  createdAt     DateTime   @default(now())
  examConfig    ExamConfig @relation(fields: [examConfigId], references: [id])

  @@unique([examConfigId, versionNumber])
  @@index([examConfigId])
}

model RuleFlags {
  id                        String     @id @default(uuid())
  examConfigId              String     @unique
  negativeMarkingEnabled    Boolean    @default(false)
  sectionalCutoffEnabled    Boolean    @default(false)
  adaptiveDifficultyEnabled Boolean    @default(false)
  shuffleQuestionsEnabled   Boolean    @default(false)
  shuffleOptionsEnabled     Boolean    @default(false)
  allowSectionNavigation    Boolean    @default(false)
  sectionTimingEnabled      Boolean    @default(false) @map("section_timing_enabled")
  maxAttempts               Int        @default(3) @map("max_attempts")
  candidateNoRepeatEnabled  Boolean    @default(false) @map("candidate_no_repeat_enabled")
  runtimeGenerationOnDeficit Boolean    @default(false) @map("runtime_generation_on_deficit")
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  examConfig                ExamConfig @relation(fields: [examConfigId], references: [id], onDelete: Cascade)

  @@index([examConfigId])
}

model Topic {
  id                    String                 @id @default(uuid())
  name                  String
  code                  String                 @unique
  description           String?
  status                TopicStatus            @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  concepts              Concept[]
  sectionTopics         SectionTopic[]
  blueprintTopicConfigs BlueprintTopicConfig[]
  questions             Question[]
  datasets              Dataset[]
}

model Concept {
  id              String               @id @default(uuid())
  topicId         String
  name            String
  code            String
  description     String?
  status          ConceptStatus        @default(ACTIVE)
  questionSources QuestionSourceType[] @default([VARIABLE_TEMPLATE]) @map("question_sources")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  topic           Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions       Question[]
  datasets        Dataset[]

  @@unique([topicId, code])
  @@index([topicId])
}

model StyleProfile {
  id               String                       @id @default(uuid())
  name             String
  profileType      String                       @map("profile_type")
  description      String?
  active           Boolean                      @default(true)
  status           String                       @default("ACTIVE")
  isDefault        Boolean                      @default(false) @map("is_default")
  languageStyle    Json                         @default("{}") @map("language_style")
  contextStyle     Json                         @default("{}") @map("context_style")
  difficultyStyle  Json                         @default("{}") @map("difficulty_style")
  distractorRules  Json                         @default("{}") @map("distractor_rules")
  explanationStyle Json                         @default("{}") @map("explanation_style")
  aiInstructions   String                       @default("") @map("ai_instructions")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")
  blueprints       Blueprint[]
  characteristics  StyleProfileCharacteristic[]

  @@index([profileType])
  @@index([active])
  @@map("style_profiles")
}

model StyleProfileCharacteristic {
  id                  String       @id @default(uuid())
  profileId           String       @map("profile_id")
  characteristicName  String       @map("characteristic_name")
  characteristicValue Json         @map("characteristic_value")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  profile             StyleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, characteristicName])
  @@index([profileId])
  @@map("style_profile_characteristics")
}

model Blueprint {
  id             String       @id @default(uuid())
  configId       String       @unique @map("config_id")
  styleProfileId String       @map("style_profile_id")
  sections       Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  examConfig     ExamConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  styleProfile   StyleProfile @relation(fields: [styleProfileId], references: [id])

  @@index([configId])
  @@index([styleProfileId])
  @@map("blueprints")
}

model SectionTopic {
  id             String          @id @default(cuid())
  sectionId      String
  topicId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  section        ExamSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic          Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicWeightage TopicWeightage?

  @@unique([sectionId, topicId])
  @@index([sectionId])
  @@index([topicId])
}

model TopicWeightage {
  id                  String       @id @default(cuid())
  sectionId           String
  topicId             String
  weightagePercentage Int
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  sectionTopic        SectionTopic @relation(fields: [sectionId, topicId], references: [sectionId, topicId], onDelete: Cascade)

  @@unique([sectionId, topicId])
  @@index([sectionId])
  @@index([topicId])
}

model ConfigPublishLog {
  id          String     @id @default(cuid())
  configId    String
  publishedBy String?
  version     String
  publishedAt DateTime   @default(now())
  examConfig  ExamConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
}

model BlueprintConfig {
  id                   String                 @id @default(uuid())
  name                 String
  code                 String                 @unique
  description          String?
  totalQuestions       Int
  totalDurationMinutes Int
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  topicConfigs         BlueprintTopicConfig[]

  @@index([deletedAt])
  @@map("blueprint_configs")
}

model BlueprintTopicConfig {
  id            String          @id @default(uuid())
  blueprintId   String
  sectionId     String
  topicId       String
  questionCount Int
  weightage     Decimal
  easyCount     Int
  mediumCount   Int
  hardCount     Int
  createdAt     DateTime        @default(now())
  blueprint     BlueprintConfig @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  examSection   ExamSection     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  topic         Topic           @relation(fields: [topicId], references: [id])

  @@unique([blueprintId, topicId])
  @@index([blueprintId])
  @@index([sectionId])
  @@index([topicId])
  @@map("blueprint_topic_configs")
}

model TemplateVariable {
  id           String       @id @default(uuid())
  templateId   String       @map("template_id")
  variableName String       @map("variable_name")
  variableType VariableType @map("variable_type")
  required     Boolean      @default(false)
  defaultValue String?      @map("default_value")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, variableName])
  @@index([templateId])
  @@map("template_variables")
}

model TemplateRule {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  ruleType   RuleType @map("rule_type")
  ruleConfig Json     @map("rule_config")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_rules")
}

model SolutionTemplate {
  id                  String   @id @default(uuid())
  templateId          String   @unique @map("template_id")
  solutionTemplate    String   @map("solution_template")
  explanationTemplate String?  @map("explanation_template")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  template            Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("solution_templates")
}

model TemplatePreview {
  id             String   @id @default(uuid())
  templateId     String   @map("template_id")
  previewPayload Json     @map("preview_payload")
