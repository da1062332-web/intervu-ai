  @@index([questionId])
  @@map("exam_config_question_usages")
}

model ConfigReadinessStats {
  configId                 String   @id @map("config_id")
  readinessScore           Int      @default(0) @map("readiness_score")
  status                   String   @default("PENDING")
  totalRequiredQuestions   Int      @default(0) @map("total_required_questions")
  availableUnusedCapacity  Int      @default(0) @map("available_unused_capacity")
  detailsJson              Json     @map("details_json")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("config_readiness_stats")
}

model TransactionalOutbox {
  id            String   @id @default(cuid())
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type")
  payload       Json
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([processed, createdAt])
  @@map("transactional_outbox")
}

enum HiringStrategyType {
  TCS
  INFOSYS
  ACCENTURE
  CAPGEMINI
  COGNIZANT
  CUSTOM
}

enum HiringMappingType {
  NUMERICAL
  VERBAL
  REASONING
  ADVANCED_APTITUDE
  CODING
}

model HiringEvaluationConfig {
  id                     String                 @id @default(cuid())
  examConfigId           String                 @unique @map("exam_config_id")
  strategy               HiringStrategyType     @default(TCS)
  enabled                Boolean                @default(false)
  ninjaThreshold         Int                    @default(0) @map("ninja_threshold")
  digitalThreshold       Int                    @default(0) @map("digital_threshold")
  primeThreshold         Int                    @default(0) @map("prime_threshold")
  advancedDigitalMin     Int                    @default(0) @map("advanced_digital_min")
  advancedPrimeMin       Int                    @default(0) @map("advanced_prime_min")
  codingTotalProblems    Int                    @default(0) @map("coding_total_problems")
  codingDigitalMinSolved Int                    @default(0) @map("coding_digital_min_solved")
  codingPrimeMinSolved   Int                    @default(0) @map("coding_prime_min_solved")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  examConfig             ExamConfig             @relation(fields: [examConfigId], references: [id], onDelete: Cascade)
  sectionMappings        HiringSectionMapping[]

  @@index([examConfigId])
  @@map("hiring_evaluation_configs")
}

model HiringSectionMapping {
  id                    String                 @id @default(cuid())
  configId              String                 @map("config_id")
  sectionCode           String                 @map("section_code")
  sectionName           String?                @map("section_name")
  mappingType           HiringMappingType      @map("mapping_type")
  minimumCorrectAnswers Int                    @default(0) @map("minimum_correct_answers")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  config                HiringEvaluationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, sectionCode, mappingType])
  @@index([configId])
  @@map("hiring_section_mappings")
}

enum CodingPatternStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CodingOracle {
  id                    String            @id @default(cuid())
  key                   String            @unique
  name                  String
  category              String            @default("GENERAL")
  description           String?
  supportedDifficulties String[]          @default(["EASY", "MEDIUM", "HARD"])
  parameterSchema       Json              @default("{}")
  metadata              Json              @default("{}")
  isActive              Boolean           @default(true)
  isSystem              Boolean           @default(true)
  version               Int               @default(1)
  creatorId             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  patterns              CodingPattern[]

  @@index([key])
  @@index([category])
  @@index([isActive])
  @@map("coding_oracles")
}

model CodingPattern {
  id                     String              @id @default(cuid())
  patternKey             String              @unique @default(cuid())
  title                  String
  slug                   String              @unique
  description            String?
  difficulty             DifficultyLevel     @default(MEDIUM)
  status                 CodingPatternStatus @default(DRAFT)
  version                Int                 @default(1)
  oracleKey              String
  statementSpecification Json                @default("{}")
  parameterSchema        Json                @default("{}")
  constraintSchema       Json                @default("{}")
  aiConfiguration        Json                @default("{}")
  starterCode            Json                @default("{}")
  metadata               Json                @default("{}")
  creatorId              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?
  testCases              CodingTestCase[]
  oracle                 CodingOracle?       @relation(fields: [oracleKey], references: [key])

  @@index([patternKey])
  @@index([oracleKey])
  @@index([difficulty])
  @@index([status])
  @@index([deletedAt])
  @@map("coding_patterns")
}

model CodingTestCase {
  id             String        @id @default(cuid())
  patternId      String
  input          Json
  expectedOutput Json
  isPublic       Boolean       @default(false)
  isStress       Boolean       @default(false)
  isBoundary     Boolean       @default(false)
  explanation    String?
  createdAt      DateTime      @default(now())
  pattern        CodingPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([patternId])
  @@index([isPublic])
  @@map("coding_test_cases")
}


