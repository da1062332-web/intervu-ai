# Environment variables for apps/api
# Copy this to .env in the same directory: cp .env.example .env

NODE_ENV=development
PORT=3000

# Database URL for PostgreSQL:
# For local dev / Docker compose: postgresql://postgres:postgres@localhost:5432/intervu_ai
# For Supabase on Render / Production:
# DATABASE_URL: Use Supabase Transaction Pooler (port 6543 with pgbouncer=true & connection_limit)
# e.g.: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intervu_ai

# DIRECT_URL: Direct database connection (port 5432) used exclusively for Prisma schema migrations
# e.g.: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/intervu_ai

# Redis connection URL (assumes local Docker compose settings)
REDIS_URL=redis://localhost:6379

# JWT secrets (Must be at least 32 characters long)
JWT_SECRET=replace-with-a-long-secret-at-least-32-chars-long-012345
JWT_REFRESH_SECRET=replace-with-another-long-secret-at-least-32-chars-long-678910

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# CORS (Comma-separated allowed origins or patterns)
CORS_ALLOWED_ORIGINS=https://www.skillitrix.com,https://skillitrix.com,https://intervu-frontend.vercel.app,https://*.vercel.app
